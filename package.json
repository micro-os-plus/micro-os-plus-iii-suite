{
  "name": "@micro-os-plus/iii-suite",
  "version": "0.1.0",
  "description": "This repository provides the **µOS++ III Suite**, a set of projects that together form the **third edition** of the µOS++ framework.",
  "keywords": [
    "micro-os-plus",
    "suite",
    "framework"
  ],
  "license": "MIT",
  "author": {
    "name": "Liviu Ionescu",
    "email": "ilg@livius.net",
    "url": "https://github.com/ilg-ul"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micro-os-plus/micro-os-plus-iii-suite.git"
  },
  "homepage": "https://github.com/micro-os-plus/micro-os-plus-iii-suite#readme",
  "bugs": {
    "url": "https://github.com/micro-os-plus/micro-os-plus-iii-suite/issues"
  },
  "$dependenciesUrls": {
    "glob": "https://www.npmjs.com/package/glob",
    "del-cli": "https://www.npmjs.com/package/del-cli",
    "json": "https://www.npmjs.com/package/json",
    "json5": "https://www.npmjs.com/package/json5",
    "jsonc-parser": "https://www.npmjs.com/package/jsonc-parser",
    "liquidjs": "https://www.npmjs.com/package/liquidjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@xpack/npm-packages-helper": "github:xpack/npm-packages-helper",
    "del-cli": "^8.0.1",
    "glob": "^14.0.4",
    "json": "^11.0.0",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "liquidjs": "^10.30.1",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "generate-top-commons": "node node_modules/@xpack/npm-packages-helper/maintenance/scripts/generate-top-commons.mjs --micro-os-plus",
    "npm-install": "npm install",
    "npm-link-helper": "npm link @xpack/npm-packages-helper",
    "npm-outdated": "npm outdated",
    "npm-ci": "npm ci",
    "npm-pack": "npm pack",
    "npm-link": "npm link",
    "git-log": "git log --pretty='%cd * %h %s' --date=short",
    "update-changelog": "node maintenance/scripts/update-changelog.mjs CHANGELOG.md",
    "git-pull-helper": "git -C ${HOME}/Work/micro-os-plus/build-helper-xpack.git pull",
    "update-submodules-check": "node maintenance/scripts/update-submodules.mjs --dry-run",
    "update-submodules": "node maintenance/scripts/update-submodules.mjs",
    "format-md-check": "prettier --config maintenance/config/.prettierrc.json --ignore-path maintenance/config/.prettierignore --prose-wrap always --check \"*.md\"",
    "format-md": "prettier --config maintenance/config/.prettierrc.json --ignore-path maintenance/config/.prettierignore --prose-wrap always --write \"*.md\"",
    "deep-clean": "del-cli node_modules package-lock.json *.tgz",
    "postversion": "git push origin --all && git push origin --tags"
  },
  "xpack": {
    "minimumXpmRequired": "0.23.2",
    "devDependencies": {
      "@xpack-dev-tools/clang": "21.1.8-1.1"
    },
    "actions": {
      "xpm-install": "xpm install",
      "xpm-link-submodules": [
        "xpm link -C rtos",
        "xpm link -C targets/architectures/cortexm",
        "xpm link -C targets/architectures/synthetic-posix",
        "xpm link -C targets/architectures/aarch32",
        "xpm link -C targets/architectures/aarch64",
        "xpm link -C targets/architectures/riscv",
        "xpm link -C 3rd-party/arm/arm-cmsis-rtos-validator",
        "xpm link -C 3rd-party/chan/chan-fatfs",
        "xpm link -C 3rd-party/libucontext/libucontext",
        "xpm link -C 3rd-party/segger/segger-rtt",
        "xpm link -C 3rd-party/segger/segger-system-view"
      ]
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
